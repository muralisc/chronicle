[Unit]
Description=Photo Frame Chromium kiosk
After=photoframe-web.service graphical.target
Wants=photoframe-web.service
Requisite=graphical.target

[Service]
Type=simple
# Wait for the web app to answer before launching the browser.
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:5000/ >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/chromium \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --incognito \
    --disable-session-crashed-bubble \
    --check-for-update-interval=31536000 \
    http://localhost:5000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
