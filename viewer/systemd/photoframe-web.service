[Unit]
Description=Photo Frame web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/photoframe
# Pi has only $CONVERTED (mounted locally); no $SOURCE here.
Environment=CONVERTED=/mnt/photos/footage_converted
Environment=PHOTOFRAME_DB=%h/photoframe.sqlite
Environment=PHOTOFRAME_PORT=5000
Environment=PHOTOFRAME_N=10
Environment=PHOTOFRAME_X_MINS=180
Environment=PHOTOFRAME_WINDOW_DAYS=3
Environment=PHOTOFRAME_SLIDE_SECONDS=60
ExecStart=%h/src/photoframe/env/bin/python %h/src/photoframe/cli.py serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
