#!/bin/bash
#
# Move footage_converted between the desktop (Machine 1, source of truth) and the
# always-on viewer (Machine 2, the Pi). footage_converted is 100% derived, so the
# desktop is always authoritative and we only ever push one way with --delete.
#
#   sync-converted push         mirror footage_converted M1 -> M2 (adds + prunes),
#                               then reindex on M2 so its DB drops removed rows.
#   sync-converted pull-marks   rsync a copy of the Pi's sqlite DB to M1; the
#                               delete tools read the marked rows straight from it.
#
# A full delete cycle: pull-marks -> review -> prune/delete_marked.py (source-only)
# -> prune/3prune-orphaned-converted.py -> push (the --delete propagates to M2).
#
# Usage:
#   sync-converted push
#   sync-converted pull-marks
#
# Override any of the config below via environment variables, e.g.
#   M2_HOST=pi@pihole sync-converted push

set -euo pipefail

# --- config (env-overridable) -----------------------------------------------
M2_HOST=${M2_HOST:-pi@machine2}
LOCAL_CONVERTED=${CONVERTED:-$HOME/data00/footage_converted}
REMOTE_CONVERTED=${M2_CONVERTED:-data00/footage_converted}   # relative to M2 $HOME
REMOTE_VIEWER=${M2_VIEWER:-src/chronicle/viewer}             # relative to M2 $HOME (push reindex)
REMOTE_PY=${M2_PY:-env/bin/python}                           # relative to REMOTE_VIEWER
REMOTE_DB=${M2_DB:-photoframe.sqlite}                        # M2 sqlite, relative to M2 $HOME
MARKS_DB_DIR=${CHRONICLE_MARKS_DIR:-$HOME/.cache/chronicle}  # where the DB copy lands on M1

RSYNC_FLAGS=(
  --archive
  --human-readable
  --itemize-changes
  --partial
  --delete
  --stats
  --info=progress2
)

BLUE=$(tput setaf 4 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

# Run viewer/cli.py on M2 (used by push to reindex). $1 is the subcommand.
remote_cli() {
  ssh "$M2_HOST" \
    "cd '$REMOTE_VIEWER' && CONVERTED='$REMOTE_CONVERTED' '$REMOTE_PY' cli.py $1"
}

itemize_legend() {
  cat <<'EOF'

rsync --itemize-changes legend (https://stackoverflow.com/a/36851784):
  YXcstpoguax path/to/file
  |||||||||||
  ||||||||||`- x: extended attribute changed   |`- file type: f file, d dir, L symlink
  |||||||||`-- a: ACL changed                   `-- update type: < sent, > received,
  ||||||||`--- u: reserved                          c local create, * message (e.g. deleting)
  |||||||`---- g: group differs
  ||||||`----- o: owner differs
  |||||`------ p: permissions differ
  ||||`------- t: mtime differs
  |||`-------- s: size differs
  ||`--------- c: checksum/content differs
EOF
}

cmd_push() {
  local src="${LOCAL_CONVERTED%/}/"            # trailing slash: mirror, don't nest
  local dst="$M2_HOST:$REMOTE_CONVERTED/"

  echo -e "Dry run: ${BLUE}${src}${RESET} -> ${BLUE}${dst}${RESET}"
  rsync "${RSYNC_FLAGS[@]}" -n "$src" "$dst"
  itemize_legend

  echo -e "\n${BLUE}Proceed with the real sync (this --deletes on M2)? [Enter to continue, Ctrl-C to abort]${RESET}"
  read -r

  rsync "${RSYNC_FLAGS[@]}" "$src" "$dst"

  echo -e "\nReindexing on ${BLUE}${M2_HOST}${RESET} to prune rows for deleted files..."
  remote_cli index
}

cmd_pull_marks() {
  # Just rsync the Pi's DB to M1 — no remote CLI, no marks file. The delete tools
  # (prune/delete_marked.py) read the marked rows straight from this copy.
  mkdir -p "$MARKS_DB_DIR"
  echo -e "Pulling DB from ${BLUE}${M2_HOST}${RESET} -> ${MARKS_DB_DIR} (incl. -wal so recent marks aren't missed)..."
  # The glob expands on the remote shell: main file + -wal (+ -shm) if present.
  rsync -a "$M2_HOST:$REMOTE_DB"* "$MARKS_DB_DIR/"

  local db="$MARKS_DB_DIR/$(basename "$REMOTE_DB")"
  echo -e "DB copy ready: ${BLUE}${db}${RESET}"
  echo "Review + act (reads this DB by default):"
  echo "  prune/delete_marked.py list"
  echo "  prune/delete_marked.py purge --dry-run"
}

case "${1:-}" in
  push)       cmd_push ;;
  pull-marks) cmd_pull_marks ;;
  *)
    echo "Usage: $(basename "$0") {push|pull-marks}" >&2
    exit 2
    ;;
esac
